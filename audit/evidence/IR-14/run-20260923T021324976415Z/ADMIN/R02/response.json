  "body_text": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#1d4ed8\">\n  <meta name=\"description\" content=\"KnowGap AI — intelligent IT support and organizational knowledge management.\">\n  <title>Administration · KnowGap AI</title>\n  <link rel=\"preconnect\" href=\"https://cdn.jsdelivr.net\">\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"/static/styles.css\">\n</head>\n<body class=\"app-body\">\n\n<div class=\"app-shell\">\n  <aside class=\"app-sidebar\" id=\"appSidebar\" aria-label=\"Primary navigation\">\n    <a class=\"brand\" href=\"/home\" aria-label=\"KnowGap AI home\">\n      <span class=\"brand-mark\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 48 48\" role=\"img\">\n          <path d=\"M13 14.5 24 8l11 6.5v13L24 34l-11-6.5z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"/>\n          <circle cx=\"24\" cy=\"21\" r=\"4\" fill=\"currentColor\"/>\n          <path d=\"M24 25v9M13 20l7 2M35 20l-7 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n        </svg>\n      </span>\n      <span>\n        <strong>KnowGap <em>AI</em></strong>\n        <small>Intelligent IT operations</small>\n      </span>\n    </a>\n\n    <div class=\"sidebar-section-label\">Workspace</div>\n    <nav class=\"sidebar-nav\">\n      \n      \n      <a class=\"sidebar-link \" href=\"/support\">\n        <i class=\"bi bi-headset\" aria-hidden=\"true\"></i><span>Resolved tickets</span>\n      </a>\n      \n      \n      <a class=\"sidebar-link \" href=\"/knowledge\">\n        <i class=\"bi bi-journal-richtext\" aria-hidden=\"true\"></i><span>Knowledge base</span>\n      </a>\n      \n      \n      \n      <a class=\"sidebar-link active\" href=\"/admin\">\n        <i class=\"bi bi-sliders2\" aria-hidden=\"true\"></i><span>Administration</span>\n      </a>\n      \n    </nav>\n\n    <div class=\"sidebar-insight\">\n      <span class=\"insight-icon\"><i class=\"bi bi-stars\" aria-hidden=\"true\"></i></span>\n      <div>\n        <strong>6 agents online</strong>\n        <small>Coordinating every request</small>\n      </div>\n      <span class=\"live-dot\" aria-label=\"System online\"></span>\n    </div>\n\n    <div class=\"sidebar-user\">\n      <a class=\"avatar\" href=\"/profile\" title=\"Open profile\" aria-label=\"Open profile\">S</a>\n      <span class=\"user-meta\">\n        <strong>System Admin Demo</strong>\n        <small>Admin</small>\n      </span>\n      <a class=\"icon-button icon-button-dark\" href=\"/profile\" title=\"Profile settings\" aria-label=\"Profile settings\">\n        <i class=\"bi bi-person-gear\" aria-hidden=\"true\"></i>\n      </a>\n      <a class=\"icon-button icon-button-dark\" href=\"/logout\" title=\"Sign out\" aria-label=\"Sign out\">\n        <i class=\"bi bi-box-arrow-right\" aria-hidden=\"true\"></i>\n      </a>\n    </div>\n  </aside>\n\n  <button class=\"sidebar-overlay\" id=\"sidebarOverlay\" type=\"button\" aria-label=\"Close navigation\"></button>\n\n  <div class=\"app-main\">\n    <header class=\"topbar\">\n      <div class=\"topbar-start\">\n        <button class=\"mobile-menu-button\" id=\"mobileMenuButton\" type=\"button\" aria-label=\"Open navigation\" aria-controls=\"appSidebar\" aria-expanded=\"false\">\n          <i class=\"bi bi-list\" aria-hidden=\"true\"></i>\n        </button>\n        <div>\n          <span class=\"topbar-eyebrow\">KnowGap workspace</span>\n          <h1 class=\"topbar-title\">Administration</h1>\n        </div>\n      </div>\n      <div class=\"topbar-actions\">\n        <div class=\"notification-wrapper\">\n          <button class=\"icon-button icon-button-light notification-button\" type=\"button\" aria-label=\"Notifications\">\n            <i class=\"bi bi-bell\" aria-hidden=\"true\"></i>\n            \n            \n          </button>\n          <div class=\"notification-panel\" aria-live=\"polite\">\n            <div class=\"notification-header\">\n              <strong>Notifications</strong>\n              <span>0</span>\n            </div>\n            \n              <div class=\"notification-item empty-notification\">\n                <div>\n                  <strong>No notifications</strong>\n                  <p>Resolved tickets will appear here.</p>\n                </div>\n              </div>\n            \n          </div>\n        </div>\n        <span class=\"system-status\"><span class=\"status-pulse\"></span>All systems operational</span>\n        <span class=\"topbar-avatar\">S</span>\n      </div>\n    </header>\n\n    <main class=\"page-content\">\n\n      \n<div class=\"page-heading heading-with-actions\">\n  <div><span class=\"section-eyebrow\">System control</span><h2>Administration</h2><p>Manage users, roles, and support categories.</p></div>\n  <div class=\"heading-actions\"><span class=\"trust-badge\"><i class=\"bi bi-shield-lock-fill\" aria-hidden=\"true\"></i> Admin only</span></div>\n</div>\n\n\n\n<section class=\"admin-section\" id=\"users\">\n  <div class=\"section-heading-row\"><div><span class=\"section-eyebrow\">Identity and access</span><h3>Users and roles</h3></div><span class=\"count-badge\">4 users</span></div>\n  <div class=\"admin-create-card surface-card\">\n    <h4><i class=\"bi bi-person-plus\" aria-hidden=\"true\"></i> Create user</h4>\n    <form method=\"post\" action=\"/admin/users/create\" class=\"admin-form-grid\">\n      <div class=\"form-field\"><label for=\"new-username\">Username</label><input id=\"new-username\" name=\"username\" required></div>\n      <div class=\"form-field\"><label for=\"new-full-name\">Full name</label><input id=\"new-full-name\" name=\"full_name\" required></div>\n      <div class=\"form-field\"><label for=\"new-password\">Temporary password</label><input id=\"new-password\" name=\"password\" type=\"password\" minlength=\"8\" required></div>\n      <div class=\"form-field\"><label for=\"new-role\">Role</label><select id=\"new-role\" name=\"role\" required><option value=\"CUSTOMER\">Customer</option><option value=\"IT_SUPPORT\">It Support</option><option value=\"KNOWLEDGE_ANALYST\">Knowledge Analyst</option><option value=\"ADMIN\">Admin</option></select></div>\n      <button class=\"btn-primary-modern\" type=\"submit\"><i class=\"bi bi-plus-lg\" aria-hidden=\"true\"></i> Add user</button>\n    </form>\n  </div>\n  <div class=\"panel-card table-card admin-table-wrap\"><div class=\"table-responsive\"><table class=\"modern-table admin-table\"><thead><tr><th>Account</th><th>Role</th><th>Status</th><th>Save</th><th>Delete</th></tr></thead><tbody>\n  <tr><td><form id=\"user-update-4\" method=\"post\" action=\"/admin/users/4\"></form><input form=\"user-update-4\" name=\"full_name\" value=\"System Admin Demo\" aria-label=\"Full name for admin\"><small>@admin</small></td><td><select form=\"user-update-4\" name=\"role\" aria-label=\"Role for admin\"><option value=\"CUSTOMER\" >Customer</option><option value=\"IT_SUPPORT\" >It Support</option><option value=\"KNOWLEDGE_ANALYST\" >Knowledge Analyst</option><option value=\"ADMIN\" selected>Admin</option></select></td><td><label class=\"check-label\"><input form=\"user-update-4\" type=\"checkbox\" name=\"is_active\" checked> Active</label></td><td><button class=\"btn-secondary-modern btn-compact\" form=\"user-update-4\" type=\"submit\"><i class=\"bi bi-save\" aria-hidden=\"true\"></i> Save</button></td><td><form method=\"post\" action=\"/admin/users/4/delete\"><button class=\"icon-button icon-button-danger\" type=\"submit\" title=\"Delete admin\" aria-label=\"Delete admin\"><i class=\"bi bi-trash3\" aria-hidden=\"true\"></i></button></form></td></tr><tr><td><form id=\"user-update-3\" method=\"post\" action=\"/admin/users/3\"></form><input form=\"user-update-3\" name=\"full_name\" value=\"Knowledge Analyst Demo\" aria-label=\"Full name for analyst\"><small>@analyst</small></td><td><select form=\"user-update-3\" name=\"role\" aria-label=\"Role for analyst\"><option value=\"CUSTOMER\" >Customer</option><option value=\"IT_SUPPORT\" >It Support</option><option value=\"KNOWLEDGE_ANALYST\" selected>Knowledge Analyst</option><option value=\"ADMIN\" >Admin</option></select></td><td><label class=\"check-label\"><input form=\"user-update-3\" type=\"checkbox\" name=\"is_active\" checked> Active</label></td><td><button class=\"btn-secondary-modern btn-compact\" form=\"user-update-3\" type=\"submit\"><i class=\"bi bi-save\" aria-hidden=\"true\"></i> Save</button></td><td><form method=\"post\" action=\"/admin/users/3/delete\"><button class=\"icon-button icon-button-danger\" type=\"submit\" title=\"Delete analyst\" aria-label=\"Delete analyst\"><i class=\"bi bi-trash3\" aria-hidden=\"true\"></i></button></form></td></tr><tr><td><form id=\"user-update-1\" method=\"post\" action=\"/admin/users/1\"></form><input form=\"user-update-1\" name=\"full_name\" value=\"Demo Customer\" aria-label=\"Full name for customer\"><small>@customer</small></td><td><select form=\"user-update-1\" name=\"role\" aria-label=\"Role for customer\"><option value=\"CUSTOMER\" selected>Customer</option><option value=\"IT_SUPPORT\" >It Support</option><option value=\"KNOWLEDGE_ANALYST\" >Knowledge Analyst</option><option value=\"ADMIN\" >Admin</option></select></td><td><label class=\"check-label\"><input form=\"user-update-1\" type=\"checkbox\" name=\"is_active\" checked> Active</label></td><td><button class=\"btn-secondary-modern btn-compact\" form=\"user-update-1\" type=\"submit\"><i class=\"bi bi-save\" aria-hidden=\"true\"></i> Save</button></td><td><form method=\"post\" action=\"/admin/users/1/delete\"><button class=\"icon-button icon-button-danger\" type=\"submit\" title=\"Delete customer\" aria-label=\"Delete customer\"><i class=\"bi bi-trash3\" aria-hidden=\"true\"></i></button></form></td></tr><tr><td><form id=\"user-update-2\" method=\"post\" action=\"/admin/users/2\"></form><input form=\"user-update-2\" name=\"full_name\" value=\"IT Support Demo\" aria-label=\"Full name for support\"><small>@support</small></td><td><select form=\"user-update-2\" name=\"role\" aria-label=\"Role for support\"><option value=\"CUSTOMER\" >Customer</option><option value=\"IT_SUPPORT\" selected>It Support</option><option value=\"KNOWLEDGE_ANALYST\" >Knowledge Analyst</option><option value=\"ADMIN\" >Admin</option></select></td><td><label class=\"check-label\"><input form=\"user-update-2\" type=\"checkbox\" name=\"is_active\" checked> Active</label></td><td><button class=\"btn-secondary-modern btn-compact\" form=\"user-update-2\" type=\"submit\"><i class=\"bi bi-save\" aria-hidden=\"true\"></i> Save</button></td><td><form method=\"post\" action=\"/admin/users/2/delete\"><button class=\"icon-button icon-button-danger\" type=\"submit\" title=\"Delete support\" aria-label=\"Delete support\"><i class=\"bi bi-trash3\" aria-hidden=\"true\"></i></button></form></td></tr>\n  </tbody></table></div></div>\n</section>\n\n<section class=\"admin-section\" id=\"articles\">\n  <div class=\"section-heading-row\"><div><span class=\"section-eyebrow\">Knowledge intake</span><h3>Create knowledge article</h3></div><span class=\"trust-badge\"><i class=\"bi bi-pencil-square\" aria-hidden=\"true\"></i> Analyst approval required</span></div>\n  <div class=\"admin-create-card surface-card\">\n    <form method=\"post\" action=\"/admin/articles/create\" class=\"admin-form-grid admin-form-wide\">\n      <div class=\"form-field\"><label for=\"new-doc-id\">Document ID</label><input id=\"new-doc-id\" value=\"KB-081\" readonly></div>\n      <div class=\"form-field\"><label for=\"new-article-title\">Title</label><input id=\"new-article-title\" name=\"title\" required></div>\n      <div class=\"form-field\"><label for=\"new-category\">Category</label><select id=\"new-category\" name=\"category\" required><option value=\"Accounts / Passwords\">Accounts / Passwords</option><option value=\"Outlook / MFA\">Outlook / MFA</option><option value=\"Printers\">Printers</option><option value=\"Remote Desktop\">Remote Desktop</option><option value=\"Software Installation\">Software Installation</option><option value=\"VPN\">VPN</option><option value=\"Wi-Fi / DNS\">Wi-Fi / DNS</option><option value=\"Windows / Updates\">Windows / Updates</option></select></div>\n      <div class=\"form-field\"><label for=\"new-os\">Supported OS</label><input id=\"new-os\" name=\"supported_os\" value=\"Any\"></div>\n      <div class=\"form-field form-field-full\"><label for=\"new-content\">Content</label><textarea id=\"new-content\" name=\"content\" rows=\"4\" required></textarea></div>\n      <button class=\"btn-primary-modern\" type=\"submit\"><i class=\"bi bi-plus-lg\" aria-hidden=\"true\"></i> Add draft article</button>\n    </form>\n  </div>\n</section>\n\n<section class=\"admin-section\" id=\"categories\">\n  <div class=\"section-heading-row\"><div><span class=\"section-eyebrow\">Classification</span><h3>Categories</h3></div><span class=\"count-badge\">8 categories</span></div>\n  <div class=\"admin-create-card surface-card\"><h4><i class=\"bi bi-tags\" aria-hidden=\"true\"></i> Create category</h4><form method=\"post\" action=\"/admin/categories/create\" class=\"admin-form-grid\"><div class=\"form-field\"><label for=\"new-category-name\">Name</label><input id=\"new-category-name\" name=\"name\" required></div><div class=\"form-field form-field-wide\"><label for=\"new-category-description\">Description</label><input id=\"new-category-description\" name=\"description\"></div><button class=\"btn-primary-modern\" type=\"submit\"><i class=\"bi bi-plus-lg\" aria-hidden=\"true\"></i> Add category</button></form></div>\n  <div class=\"admin-category-grid\"><form method=\"post\" action=\"/admin/categories/1\" class=\"surface-card admin-category-card\"><div class=\"admin-edit-header\"><i class=\"bi bi-tag-fill\" aria-hidden=\"true\"></i><button class=\"icon-button icon-button-danger\" formaction=\"/admin/categories/1/delete\" formmethod=\"post\" type=\"submit\" title=\"Delete category\" aria-label=\"Delete category\"><i class=\"bi bi-trash3\" aria-hidden=\"true\"></i></button></div><div class=\"form-field\"><label>Name</label><input name=\"name\" value=\"Accounts / Passwords\" required></div><div class=\"form-field\"><label>Description</label><input name=\"description\" value=\"\"></div><label class=\"check-label\"><input type=\"checkbox\" name=\"is_active\" checked> Active</label><button class=\"btn-secondary-modern btn-compact\" type=\"submit\"><i class=\"bi bi-save\" aria-hidden=\"true\"></i> Save</button></form><form method=\"post\" action=\"/admin/categories/2\" class=\"surface-card admin-category-card\"><div class=\"admin-edit-header\"><i class=\"bi bi-tag-fill\" aria-hidden=\"true\"></i><button class=\"icon-button icon-button-danger\" formaction=\"/admin/categories/2/delete\" formmethod=\"post\" type=\"submit\" title=\"Delete category\" aria-label=\"Delete category\"><i class=\"bi bi-trash3\" aria-hidden=\"true\"></i></button></div><div class=\"form-field\"><label>Name</label><input name=\"name\" value=\"Outlook / MFA\" required></div><div class=\"form-field\"><label>Description</label><input name=\"description\" value=\"\"></div><label class=\"check-label\"><input type=\"checkbox\" name=\"is_active\" checked> Active</label><button class=\"btn-secondary-modern btn-compact\" type=\"submit\"><i class=\"bi bi-save\" aria-hidden=\"true\"></i> Save</button></form><form method=\"post\" action=\"/admin/categories/3\" class=\"surface-card admin-category-card\"><div class=\"admin-edit-header\"><i class=\"bi bi-tag-fill\" aria-hidden=\"true\"></i><button class=\"icon-button icon-button-danger\" formaction=\"/admin/categories/3/delete\" formmethod=\"post\" type=\"submit\" title=\"Delete category\" aria-label=\"Delete category\"><i class=\"bi bi-trash3\" aria-hidden=\"true\"></i></button></div><div class=\"form-field\"><label>Name</label><input name=\"name\" value=\"Printers\" required></div><div class=\"form-field\"><label>Description</label><input name=\"description\" value=\"\"></div><label class=\"check-label\"><input type=\"checkbox\" name=\"is_active\" checked> Active</label><button class=\"btn-secondary-modern btn-compact\" type=\"submit\"><i class=\"bi bi-save\" aria-hidden=\"true\"></i> Save</button></form><form method=\"post\" action=\"/admin/categories/4\" class=\"surface-card admin-category-card\"><div class=\"admin-edit-header\"><i class=\"bi bi-tag-fill\" aria-hidden=\"true\"></i><button class=\"icon-button icon-button-danger\" formaction=\"/admin/categories/4/delete\" formmethod=\"post\" type=\"submit\" title=\"Delete category\" aria-label=\"Delete category\"><i class=\"bi bi-trash3\" aria-hidden=\"true\"></i></button></div><div class=\"form-field\"><label>Name</label><input name=\"name\" value=\"Remote Desktop\" required></div><div class=\"form-field\"><label>Description</label><input name=\"description\" value=\"\"></div><label class=\"check-label\"><input type=\"checkbox\" name=\"is_active\" checked> Active</label><button class=\"btn-secondary-modern btn-compact\" type=\"submit\"><i class=\"bi bi-save\" aria-hidden=\"true\"></i> Save</button></form><form method=\"post\" action=\"/admin/categories/5\" class=\"surface-card admin-category-card\"><div class=\"admin-edit-header\"><i class=\"bi bi-tag-fill\" aria-hidden=\"true\"></i><button class=\"icon-button icon-button-danger\" formaction=\"/admin/categories/5/delete\" formmethod=\"post\" type=\"submit\" title=\"Delete category\" aria-label=\"Delete category\"><i class=\"bi bi-trash3\" aria-hidden=\"true\"></i></button></div><div class=\"form-field\"><label>Name</label><input name=\"name\" value=\"Software Installation\" required></div><div class=\"form-field\"><label>Description</label><input name=\"description\" value=\"\"></div><label class=\"check-label\"><input type=\"checkbox\" name=\"is_active\" checked> Active</label><button class=\"btn-secondary-modern btn-compact\" type=\"submit\"><i class=\"bi bi-save\" aria-hidden=\"true\"></i> Save</button></form><form method=\"post\" action=\"/admin/categories/6\" class=\"surface-card admin-category-card\"><div class=\"admin-edit-header\"><i class=\"bi bi-tag-fill\" aria-hidden=\"true\"></i><button class=\"icon-button icon-button-danger\" formaction=\"/admin/categories/6/delete\" formmethod=\"post\" type=\"submit\" title=\"Delete category\" aria-label=\"Delete category\"><i class=\"bi bi-trash3\" aria-hidden=\"true\"></i></button></div><div class=\"form-field\"><label>Name</label><input name=\"name\" value=\"VPN\" required></div><div class=\"form-field\"><label>Description</label><input name=\"description\" value=\"\"></div><label class=\"check-label\"><input type=\"checkbox\" name=\"is_active\" checked> Active</label><button class=\"btn-secondary-modern btn-compact\" type=\"submit\"><i class=\"bi bi-save\" aria-hidden=\"true\"></i> Save</button></form><form method=\"post\" action=\"/admin/categories/7\" class=\"surface-card admin-category-card\"><div class=\"admin-edit-header\"><i class=\"bi bi-tag-fill\" aria-hidden=\"true\"></i><button class=\"icon-button icon-button-danger\" formaction=\"/admin/categories/7/delete\" formmethod=\"post\" type=\"submit\" title=\"Delete category\" aria-label=\"Delete category\"><i class=\"bi bi-trash3\" aria-hidden=\"true\"></i></button></div><div class=\"form-field\"><label>Name</label><input name=\"name\" value=\"Wi-Fi / DNS\" required></div><div class=\"form-field\"><label>Description</label><input name=\"description\" value=\"\"></div><label class=\"check-label\"><input type=\"checkbox\" name=\"is_active\" checked> Active</label><button class=\"btn-secondary-modern btn-compact\" type=\"submit\"><i class=\"bi bi-save\" aria-hidden=\"true\"></i> Save</button></form><form method=\"post\" action=\"/admin/categories/8\" class=\"surface-card admin-category-card\"><div class=\"admin-edit-header\"><i class=\"bi bi-tag-fill\" aria-hidden=\"true\"></i><button class=\"icon-button icon-button-danger\" formaction=\"/admin/categories/8/delete\" formmethod=\"post\" type=\"submit\" title=\"Delete category\" aria-label=\"Delete category\"><i class=\"bi bi-trash3\" aria-hidden=\"true\"></i></button></div><div class=\"form-field\"><label>Name</label><input name=\"name\" value=\"Windows / Updates\" required></div><div class=\"form-field\"><label>Description</label><input name=\"description\" value=\"\"></div><label class=\"check-label\"><input type=\"checkbox\" name=\"is_active\" checked> Active</label><button class=\"btn-secondary-modern btn-compact\" type=\"submit\"><i class=\"bi bi-save\" aria-hidden=\"true\"></i> Save</button></form></div>\n</section>\n\n    </main>\n\n\n    <footer class=\"app-footer\">\n      <span>KnowGap AI</span>\n      <span>Responsible, evidence-grounded IT support</span>\n    </footer>\n  </div>\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js\"></script>\n<script>\n  (() => {\n    const sidebar = document.getElementById('appSidebar');\n    const trigger = document.getElementById('mobileMenuButton');\n    const overlay = document.getElementById('sidebarOverlay');\n    if (!sidebar || !trigger || !overlay) return;\n\n    const setOpen = (open) => {\n      sidebar.classList.toggle('is-open', open);\n      overlay.classList.toggle('is-visible', open);\n      document.body.classList.toggle('nav-open', open);\n      trigger.setAttribute('aria-expanded', String(open));\n    };\n\n    trigger.addEventListener('click', () => setOpen(!sidebar.classList.contains('is-open')));\n    overlay.addEventListener('click', () => setOpen(false));\n    sidebar.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));\n    document.addEventListener('keydown', (event) => {\n      if (event.key === 'Escape') setOpen(false);\n    });\n\n    const notificationButton = document.querySelector('.notification-button');\n    const notificationPanel = document.querySelector('.notification-panel');\n    if (notificationButton && notificationPanel) {\n      notificationButton.addEventListener('click', (event) => {\n        event.stopPropagation();\n        const isVisible = notificationPanel.classList.toggle('is-visible');\n        notificationButton.setAttribute('aria-expanded', String(isVisible));\n      });\n      document.addEventListener('click', (event) => {\n        if (!notificationButton.contains(event.target) && !notificationPanel.contains(event.target)) {\n          notificationPanel.classList.remove('is-visible');\n          notificationButton.setAttribute('aria-expanded', 'false');\n        }\n      });\n    }\n  })();\n</script>\n\n</body>\n</html>",
